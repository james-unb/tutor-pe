  \begin{enumerate}
  \def\labelenumii{(\alph{enumii})}
  \item
    \(H_0: \bar{x}=95\; \emph{vs. }  H_a: \bar{x}=95.32\). \(H_0\) não é
    rejeitada.
  \item
    \(H_0: \bar{x}=95.32\; \emph{vs. }  H_a: \bar{x}>95.32\). \(H_0\) é
