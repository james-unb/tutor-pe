  \item
    \(0.716\)
  \item
    \(0.416\)
  \item
    \(0.284\)
  \item
    \(0.586\)
  \item
    \(0.871\)
  \end{enumerate}

  \textbf{Solution}\\
  Se \(X\) denota o número de caras obtidas após os 200 lançamentos,
