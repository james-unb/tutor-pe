\item
  \textbf{Question}\\
  Seja \(\overline{X}\) a média amostral de uma amostra aleatória de
  tamanho \(n\) coletada de uma população \(X\) com média \(\mu\) e
  variância \(\sigma^2\). Seria \textbf{incorreto} afirmar que

  \begin{enumerate}
  \def\labelenumii{(\alph{enumii})}
  \item
    A variância de X é \(\sigma^2\).
  \item
    A média amostral \(\overline{X}\) é um estimador de \(\mu\).
  \item
    A distribuição de probabilidade de \(\overline{X}\) é
    aproximadamente Normal quando \(n\to\infty\).
  \item
    A média populacional é dada por \(\overline{X}\).
  \item
    A média de \(\overline{X}\) é \(\mu\).
  \end{enumerate}

  \textbf{Solution}\\

  \begin{enumerate}
  \def\labelenumii{(\alph{enumii})}
  \item
    Falso
  \item
    Falso
  \item
    Falso
  \item
    Verdadeiro
  \item
    Falso
  \end{enumerate}
